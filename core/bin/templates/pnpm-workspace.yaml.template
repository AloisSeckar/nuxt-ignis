# settings for Nuxt & pnpm

# https://pnpm.io/settings#shamefullyhoist
# required to handle transitive dependencies 
# without having to explicitly declare them
shamefullyHoist: true

# https://pnpm.io/settings#trustpolicy
# for better supply-chain attack protection, new packages
# cannot change their state from trusted to untrusted
trustPolicy: no-downgrade

# https://pnpm.io/settings#minimumreleaseage
# for better supply-chain attack protection, new packages
# cannot be installed unless they are at least 3 days old
minimumReleaseAge: 4320

# trusted and verified packages may be excluded
minimumReleaseAgeExclude:
  # nuxt-ignis and its submodules must be excluded to allow 
  # installing latest version without 3 days cooldown
  - nuxt-ignis 
  - '@nuxt-ignis/content'
  - '@nuxt-ignis/default'
  - '@nuxt-ignis/db'
  - '@nuxt-ignis/forms'
  - '@nuxt-ignis/ui'
  - '@nuxt-ignis/utils'
  - '@nuxt-ignis/validation'
  # add more if needed
  # - package-name

# https://pnpm.io/settings#allowBuilds
# pnpm naturally blocks all post-install scripts
# some are required for development, others are not relevant
allowBuilds:
  # allows node-gyp build of associated native binaries from local sources
  # kept enabled because 'sharp' is a runtime dependency
  sharp: true
  # provides fallback repair of platform-specific Rust native engine
  # kept enabled because it can actively detect and fix problems on some platforms
  unrs-resolver: true
  # allows node-gyp build of associated native binaries from local sources
  # disabled because it would require an explicit opt-in
  '@parcel/watcher': false
  # provides fallback download of platform-specific Rust native engine
  # disabled because the required dependency is already resolved by pnpm install
  '@tailwindcss/oxide': false
  # optimization for CLI usage of 'esbuild'
  # disabled because its runtime resolves native binaries itself
  esbuild: false
  # compatibility feature for Vue 2 and Vue 3
  # disabled because project is Vue 3 only
  vue-demi: false
  # post-install script is empty in published package
  # disabled because there is no action executed
  maplibre-gl: false
  # add more if needed
  # - package-name: boolean

# recommended overrides for various (mostly security) reasons
overrides:
  # suspicious v4 comming from @formkit/nuxt@2.1.2
  chokidar: ^5.0.0
  # suspicious v6 comming from nuxt-security@2.6.0
  semver: ^7.7.0
  # CVE-2026-9277
  shell-quote: 1.8.4
  # CVE-2026-46625 (old version being pulled via @vue/test-utils)
  js-cookie: ^3.0.7
